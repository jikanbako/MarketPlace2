NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
# Supabase renamed "anon key" to "publishable key" on newer projects —
# use whichever name your project's API settings show you.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Optional — leave blank to skip analytics for now
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com
