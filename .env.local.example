NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
# Supabase renamed "anon key" to "publishable key" on newer projects —
# use whichever name your project's API settings show you.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Optional — leave blank to skip analytics for now
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com

# Push notifications — a ready-to-use VAPID key pair was generated for
# you. You can use these as-is, or generate your own with
# `npx web-push generate-vapid-keys`. NEXT_PUBLIC_VAPID_PUBLIC_KEY is
# safe to expose (it's meant to be public); VAPID_PRIVATE_KEY must
# never be exposed to the browser — no NEXT_PUBLIC_ prefix, server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BN-lQOinnblyb_jNLCXPrw0AmLZf8uZM-9qySbh-6lupUbe5mUieZ0b4geyhbxDYANJwdX5M2qzJ8tFsGlK-9yY
VAPID_PRIVATE_KEY=Bw2MEFS7Qg0EYBnvuzRR4bKfKSVCMVjn_7GAQHp_YPM

# A password-style random string you make up yourself — must match the
# value you put in the app_settings table's 'push_api_secret' row (see
# README). This is what proves a request to /api/send-push actually
# came from your own database, not a stranger.
PUSH_API_SECRET=change-this-to-a-long-random-string

# Supabase → Project Settings → API → service_role key (NOT the anon/
# publishable key). Server-only — this bypasses Row Level Security, so
# never expose it to the browser or commit it anywhere.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
